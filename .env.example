# SignalDesk backend environment
#
# Phase 1 (demo) runs with NONE of these set. Every provider degrades to its
# deterministic demo adapter when credentials are missing, and demo mode can
# never send a real email.

# --- Runtime mode -----------------------------------------------------------
# "demo" (default) uses deterministic in-process providers.
# "production" activates the real adapters when their credentials exist; if a
# required credential is missing the pipeline degrades back to demo.
APP_MODE=demo

# When "true" in production, the server refuses to start if a required
# credential is missing. Otherwise /api/health reports "degraded".
# STRICT_STARTUP=true

# --- Phase 3: durable infrastructure (production) ---------------------------
# DATABASE_URL=postgres://user:password@host/signaldesk
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# --- Company research (production) ------------------------------------------
# FIRECRAWL_API_KEY=

# --- AI structured extraction + drafting (production) -----------------------
# Vercel AI Gateway key + model id, e.g. "openai/gpt-4o-mini".
# AI_GATEWAY_API_KEY=
# AI_MODEL=openai/gpt-4o-mini

# --- Email delivery (production; disabled in demo) --------------------------
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=outreach@example.com
# Svix signing secret for the Resend delivery webhook.
# RESEND_WEBHOOK_SECRET=

# --- CRM sync (production) --------------------------------------------------
# HUBSPOT_ACCESS_TOKEN=
# Generic webhook CRM target (e.g. a Make.com scenario).
# CRM_WEBHOOK_URL=

# --- Webhook security -------------------------------------------------------
# When set, inbound webhooks must send a valid X-SignalDesk-Signature (HMAC-SHA256).
# WEBHOOK_SIGNING_SECRET=

# --- Observability ----------------------------------------------------------
# SENTRY_DSN=
